# Karel-DocBot Environment Configuration
# Copy this file to .env and fill in the required keys

# ── Required ──────────────────────────────────────────────────────
# Ollama API Key for AI features (Chat and Risk Analysis)
# Get your key from https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key_here

# ── Optional ──────────────────────────────────────────────────────
# Override the Ollama endpoint (default: https://ollama.com/api/chat)
# Useful for local development with a local Ollama instance.
# OLLAMA_API_ENDPOINT=http://localhost:11434/api/chat

# Override default model (default: deepseek-v4-flash)
# DEFAULT_MODEL=kimi-k2.7-code
